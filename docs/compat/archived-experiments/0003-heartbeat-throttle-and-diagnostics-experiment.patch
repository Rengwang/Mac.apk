+// ThreadCpuTrace -- TEMP DIAGNOSTIC (2026-10-28). Logs the top CPU-consuming
+// threads by DELTA every few seconds, using ThreadMXBean.getThreadCpuTime
+// (kernel user+system time of that thread, so it is immune to whatever else
+// the host is doing -- the property we need when the machine is busy).
+//
+// WHY: the frame-phase trace says this runtime's own canvas draw+present is
+// ~0.3 ms/frame, while the process burns ~0.6 core on a playing video. That
+// gap has to be attributed to specific threads before anything is "optimised";
+// guessing produced the wrong fix twice already.
+//
+// MACAPK_THREAD_CPU=1 turns it on. Zero cost (never started) otherwise.
+package com.macapk.loader;
+
+import java.lang.management.ManagementFactory;
+import java.lang.management.ThreadInfo;
+import java.lang.management.ThreadMXBean;
+import java.util.ArrayList;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+
+public final class ThreadCpuTrace {
+    private static final String TAG = "Mac.apk.ThreadCpu";
+    private static final boolean ON = "1".equals(System.getenv("MACAPK_THREAD_CPU"));
+    private static Thread sThread;
+
+    private ThreadCpuTrace() {}
+
+    public static synchronized void start() {
+        if (!ON || sThread != null) return;
+        sThread = new Thread(ThreadCpuTrace::loop, "macapk-thread-cpu");
+        sThread.setDaemon(true);
+        sThread.start();
+    }
+
+    private static void loop() {
+        final ThreadMXBean mx = ManagementFactory.getThreadMXBean();
+        if (mx == null || !mx.isThreadCpuTimeSupported()) return;
+        try { mx.setThreadCpuTimeEnabled(true); } catch (Throwable ignored) {}
+        final Map<Long, Long> prev = new HashMap<>();
+        long lastProcMs = 0; long procDeltaMs = 0; boolean prevProcSet = false;
+        final long windowMs = 5000;
+        while (true) {
+            try { Thread.sleep(windowMs); } catch (InterruptedException e) { return; }
+            final long[] ids = mx.getAllThreadIds();
+            final List<long[]> rows = new ArrayList<>();
+            for (long id : ids) {
+                long now = mx.getThreadCpuTime(id);
+                if (now < 0) continue;
+                Long was = prev.put(id, now);
+                if (was == null) continue;
+                long dMs = (now - was) / 1_000_000L;
+                if (dMs >= 40) rows.add(new long[]{id, dMs});
+            }
+            rows.sort((a, b) -> Long.compare(b[1], a[1]));
+            StringBuilder sb = new StringBuilder("top threads over ")
+                .append(windowMs / 1000).append("s (ms cpu):");
+            int n = 0;
+            for (long[] r : rows) {
+                if (n++ >= 14) break;
+                ThreadInfo ti;
+                try { ti = mx.getThreadInfo(r[0]); } catch (Throwable t) { ti = null; }
+                sb.append(" | ").append(ti == null ? ("tid" + r[0]) : ti.getThreadName())
+                  .append('=').append(r[1]);
+            }
+            // Process-vs-Java split: ThreadMXBean only sees Java threads, so a
+            // static page reading 2% here while `ps` says 16% means the other
+            // 14% is in NATIVE threads (vsync, Metal, ANGLE). That distinction
+            // decides where the next optimisation goes.
+            long javaTotalMs = 0;
+            for (long[] r : rows) javaTotalMs += r[1];
+            long procMs = -1;
+            try {
+                java.lang.management.OperatingSystemMXBean os =
+                    ManagementFactory.getOperatingSystemMXBean();
+                java.lang.reflect.Method m = os.getClass().getMethod("getProcessCpuTime");
+                Object v = m.invoke(os);
+                if (v instanceof Long) procMs = ((Long) v) / 1_000_000L - lastProcMs;
+                if (v instanceof Long) lastProcMs = ((Long) v) / 1_000_000L;
+                // The delta above is only meaningful once we have a baseline.
+                if (prevProcSet) procDeltaMs = procMs; else prevProcSet = true;
+            } catch (Throwable ignored) { }
+            NativeLog.i(TAG, "  process=" + (prevProcSet ? procDeltaMs + "ms" : "?")
+                + " javaTopSum=" + javaTotalMs + "ms over " + (windowMs / 1000) + "s");
+            NativeLog.i(TAG, sb.toString());
+            // Print where the hottest thread actually is. JIT hides native
+            // symbols in `sample`, but a Java stack is exact -- this is the
+            // half of the picture `sample` cannot give us.
+            for (int i = 0; i < Math.min(3, rows.size()); ++i) {
+                long id = rows.get(i)[0];
+                ThreadInfo ti;
+                try { ti = mx.getThreadInfo(id, 8); } catch (Throwable t) { ti = null; }
+                if (ti == null) continue;
+                StringBuilder st = new StringBuilder("  stack ")
+                    .append(ti.getThreadName()).append(':');
+                StackTraceElement[] frames = ti.getStackTrace();
+                for (int k = 0; k < Math.min(8, frames.length); ++k) {
+                    st.append("\n      at ").append(frames[k]);
+                }
+                NativeLog.i(TAG, st.toString());
+            }
+        }
+    }
+}
