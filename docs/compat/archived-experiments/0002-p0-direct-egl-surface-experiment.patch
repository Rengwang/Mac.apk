+                                                  jobject dpy, jobject cfg, jintArray attribs,
+                                                  jint key, jint x, jint y, jint w, jint h) {
+    if (!dpy || !cfg) return nullptr;
+    EGLDisplay d = static_cast<EGLDisplay>(HandleOf(env, dpy));
+    EGLConfig c = static_cast<EGLConfig>(HandleOf(env, cfg));
+    if (!d || !c) return nullptr;
+    int lw = 0, lh = 0;
+    void* layer = CocoaEnsureNativeEglLayerFor(key, x, y, w, h, &lw, &lh);
+    if (!layer) {
+        std::fprintf(stderr, "[E] angle: direct window: no per-surface layer for key %d "
+                             "-> EGL_NO_SURFACE\n", (int)key);
+        std::fflush(stderr);
+        return nullptr;
+    }
+    std::vector<EGLint> al;
+    if (attribs) {
+        jsize n = env->GetArrayLength(attribs);
+        al.resize(static_cast<size_t>(n));
+        if (n > 0) env->GetIntArrayRegion(attribs, 0, n, al.data());
+    }
+    EGLSurface s = eglCreateWindowSurface(d, c, reinterpret_cast<EGLNativeWindowType>(layer),
+                                          attribs ? al.data() : nullptr);
+    if (s == EGL_NO_SURFACE) {
+        std::fprintf(stderr, "[E] angle: direct window: eglCreateWindowSurface on layer %p "
+                             "(key=%d %dx%d) failed: 0x%x\n", layer, (int)key, lw, lh,
+                     eglGetError());
+        std::fflush(stderr);
+        CocoaReleaseDirectLayer(key);
+        return nullptr;
+    }
+    std::fprintf(stderr, "[I] angle: direct window surface %p on per-surface layer %p "
+                         "(key=%d %dx%d)\n", (void*)s, layer, (int)key, lw, lh);
+    std::fflush(stderr);
