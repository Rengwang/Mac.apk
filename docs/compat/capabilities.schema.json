{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mac.apk.local/schemas/capabilities.schema.json",
  "title": "Mac.apk Compatibility Capabilities Registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "api_anchor",
    "sdk_policy",
    "staleness_anchor",
    "surfaces",
    "capabilities"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "api_anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "aosp_tag",
        "api_level",
        "version_name",
        "framework_res_script",
        "api_index_gap"
      ],
      "properties": {
        "aosp_tag": {
          "type": "string",
          "minLength": 1
        },
        "api_level": {
          "type": "integer",
          "minimum": 1
        },
        "version_name": {
          "type": "string",
          "minLength": 1
        },
        "framework_res_script": {
          "type": "string",
          "minLength": 1
        },
        "api_index_gap": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "sdk_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "default_sdk",
        "floor_sdk",
        "ceiling_sdk",
        "max_known_sdk",
        "sdk_from_target_default",
        "overrides",
        "version_codes_unverified_names",
        "implementation"
      ],
      "properties": {
        "default_sdk": {
          "type": "integer",
          "minimum": 1
        },
        "floor_sdk": {
          "type": "integer",
          "minimum": 1
        },
        "ceiling_sdk": {
          "type": "integer",
          "minimum": 1
        },
        "max_known_sdk": {
          "type": "integer",
          "minimum": 1
        },
        "sdk_from_target_default": {
          "type": "boolean"
        },
        "overrides": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "version_codes_unverified_names": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "implementation": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        }
      }
    },
    "staleness_anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "build_id",
        "inventory_sha256",
        "test_manifest_sha256",
        "tracked_file_hashes",
        "status"
      ],
      "properties": {
        "build_id": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "inventory_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "test_manifest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "tracked_file_hashes": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "status": {
          "type": "string",
          "enum": ["fresh", "stale", "unknown"]
        }
      }
    },
    "surfaces": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "public_sdk",
        "hidden_api",
        "jni_registration",
        "bionic_abi",
        "service_property"
      ],
      "properties": {
        "public_sdk": { "$ref": "#/$defs/surfaceSummary" },
        "hidden_api": { "$ref": "#/$defs/surfaceSummary" },
        "jni_registration": { "$ref": "#/$defs/surfaceSummary" },
        "bionic_abi": { "$ref": "#/$defs/surfaceSummary" },
        "service_property": { "$ref": "#/$defs/surfaceSummary" }
      }
    },
    "capabilities": {
      "type": "array",
      "minItems": 20,
      "items": { "$ref": "#/$defs/capabilityEntry" }
    }
  },
  "$defs": {
    "surfaceSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "description",
        "source",
        "denominator",
        "counts",
        "blind_spots"
      ],
      "properties": {
        "description": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 },
        "denominator": {
          "type": "object",
          "required": ["local_total", "upstream_total", "upstream_note"],
          "properties": {
            "local_total": { "type": "integer", "minimum": 0 },
            "upstream_total": { "type": ["integer", "null"] },
            "upstream_note": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": { "type": ["integer", "string", "null"] }
        },
        "counts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "implemented",
            "partial",
            "unsupported",
            "missing",
            "unknown",
            "verified"
          ],
          "properties": {
            "implemented": { "type": "integer", "minimum": 0 },
            "partial": { "type": "integer", "minimum": 0 },
            "unsupported": { "type": "integer", "minimum": 0 },
            "missing": { "type": "integer", "minimum": 0 },
            "unknown": { "type": "integer", "minimum": 0 },
            "verified": { "type": "integer", "minimum": 0 }
          }
        },
        "blind_spots": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "capabilityEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "subsystem",
        "surface",
        "name",
        "api_abi_version",
        "signatures",
        "implementation",
        "aosp_source",
        "support_status",
        "verification_status",
        "staleness",
        "limitations",
        "test_ids",
        "evidence",
        "verified_version",
        "verified_date",
        "gap_ids",
        "related_gates",
        "inventory_refs"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Z]+-[0-9]{3,}$"
        },
        "subsystem": {
          "type": "string",
          "enum": [
            "resources",
            "lifecycle",
            "parcel_binder",
            "surface_scheduling",
            "media",
            "native_abi"
          ]
        },
        "surface": {
          "type": "string",
          "enum": [
            "public_sdk",
            "hidden_api",
            "jni_registration",
            "bionic_abi",
            "service_property"
          ]
        },
        "name": { "type": "string", "minLength": 1 },
        "api_abi_version": { "type": "string", "minLength": 1 },
        "signatures": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "implementation": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "aosp_source": { "type": "string", "minLength": 1 },
        "support_status": {
          "type": "string",
          "enum": ["implemented", "partial", "unsupported", "missing", "unknown"]
        },
        "verification_status": {
          "type": "string",
          "enum": ["unverified", "contract-tested", "android-compared"]
        },
        "staleness": {
          "type": "string",
          "enum": ["fresh", "stale", "unknown"]
        },
        "limitations": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "test_ids": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "evidence": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "verified_version": {
          "type": ["string", "null"]
        },
        "verified_date": {
          "type": ["string", "null"],
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "gap_ids": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "related_gates": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "inventory_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "verification_status": { "enum": ["contract-tested", "android-compared"] }
            },
            "required": ["verification_status"]
          },
          "then": {
            "properties": {
              "test_ids": { "minItems": 1 },
              "evidence": { "minItems": 1 },
              "verified_version": { "type": "string", "minLength": 1 },
              "verified_date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" }
            }
          }
        }
      ]
    }
  }
}
